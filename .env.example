# Copy to .env (gitignored) and adjust. Docker Compose reads .env automatically;
# the backend's `local` profile imports it via spring.config.import.
# Values below are for LOCAL DEVELOPMENT ONLY.

# --- PostgreSQL (docker compose) ---
# Postgres applies these three only when its data volume is first created (docs/DEVELOPMENT.md §7).
POSTGRES_DB=memoirist
POSTGRES_USER=memoirist
POSTGRES_PASSWORD=change-me-local
DB_URL=jdbc:postgresql://localhost:5432/memoirist

# --- Object storage (SeaweedFS locally; Cloudflare R2 in production) ---
STORAGE_ENDPOINT=http://localhost:8333
# Address the browser uses for presigned URLs (differs from STORAGE_ENDPOINT only if the backend runs inside Docker)
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=memoirist-media
# Compose also gives these two to SeaweedFS as its S3 credentials, and won't start if either is empty (docs/DECISIONS.md D-03)
STORAGE_ACCESS_KEY=memoirist-local
STORAGE_SECRET_KEY=change-me-local
STORAGE_PATH_STYLE=true
STORAGE_PRESIGN_TTL=PT60M

# --- Spotify search for soundtracks (optional; docs/DECISIONS.md D-35) ---
# App-only credentials from your Spotify developer app. Leave them empty to turn search off;
# pasting a Spotify link still works.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Phase 2 (production; set in Render/Vercel, not here) ---
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_PATH_STYLE=true
# JWT_SECRET=

# --- Phase 4 (AI provider decided at Phase 4, see docs/DECISIONS.md D-18) ---
